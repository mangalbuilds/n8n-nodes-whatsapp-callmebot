{
  "name": "n8n-nodes-whatsapp-callmebot",
  "version": "1.0.0",
  "description": "Send instant free WhatsApp notifications and alerts directly from n8n using CallMeBot API",
  "keywords": [
    "n8n-community-node-package",
    "n8n-nodes",
    "whatsapp",
    "callmebot",
    "speed-to-lead",
    "notifications",
    "alerts"
  ],
  "license": "MIT",
  "homepage": "https://github.com/mangalbuilds/n8n-nodes-whatsapp-callmebot#readme",
  "author": {
    "name": "Mangal Soren",
    "email": "mangal@usevance.com",
    "url": "https://usevance.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mangalbuilds/n8n-nodes-whatsapp-callmebot.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp copy:icons",
    "dev": "tsc --watch",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint --ext .ts .",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CallMeBotApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/CallMeBot/CallMeBot.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.36.0",
    "typescript": "~5.3.3"
  }
}

